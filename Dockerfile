#     -p 8765:8765 \
#     sonarr-agent
#
# agent.env takes the same settings as /etc/sonarr-agent/agent.env in the LXC; see .env.example and the README.

FROM python:3.13-slim-trixie

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates \
 && rm -rf /var/lib/apt/lists/*

RUN groupadd --system sonarr-agent \
 && useradd --system --gid sonarr-agent --home-dir /var/lib/sonarr-agent --shell /usr/sbin/nologin sonarr-agent \
 && install -d -o sonarr-agent -g sonarr-agent /var/lib/sonarr-agent

WORKDIR /opt/sonarr-agent/app
COPY requirements.txt ./
RUN pip install -r requirements.txt
COPY sonarr_agent/ ./sonarr_agent/
ARG REVISION=unknown
RUN echo "$REVISION" > REVISION

ENV STATE_PATH=/var/lib/sonarr-agent/state.json
USER sonarr-agent
VOLUME ["/var/lib/sonarr-agent"]
EXPOSE 8765
CMD ["python", "-m", "sonarr_agent"]
